{
  "name": "printhive",
  "version": "1.5.0",
  "description": "Web application for 3D printer management - monitor printers, manage models and timelapses",
  "main": "simple-server.js",
  "scripts": {
    "start": "node simple-server.js",
    "dev": "nodemon simple-server.js",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "reset-admin": "node reset-admin.js",
    "docker:build": "docker build -t printhive:latest .",
    "docker:run": "docker run -d --name printhive -p 3000:3000 -v printhive_data:/app/data -v printhive_library:/app/library -v printhive_sessions:/app/sessions printhive:latest"
  },
  "keywords": [
    "printhive",
    "3d-printer",
    "timelapse",
    "printer-management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.88",
    "adm-zip": "^0.6.1",
    "axios": "^1.21.1",
    "basic-ftp": "^6.2.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.2.0",
    "jszip": "^3.10.1",
    "mqtt": "^5.14.1",
    "multer": "^2.5.0",
    "openid-client": "^6.8.1",
    "passport": "^0.7.0",
    "pg": "^8.22.0",
    "session-file-store": "^1.5.0",
    "ssh2-sftp-client": "^12.0.1",
    "tar": "^7.5.23",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.100.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.2",
    "aedes": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "hls.js": "^1.6.15",
    "lucide-react": "^1.14.0",
    "nodemon": "^3.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "three": "^0.182.0",
    "threejs-webworker-3mf-loader": "github:manyfold3d/threejs-webworker-3mf-loader",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.9",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "async": "^3.2.6",
    "cross-spawn": "^7.0.6",
    "glob": "^11.0.0",
    "brace-expansion": "^2.1.6"
  },
  "engines": {
    "node": ">=22"
  }
}
