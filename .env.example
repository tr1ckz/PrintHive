# Server Configuration
PORT=3000                    # Application port (default: 3000)
HOST_PORT=3000              # Host port for docker-compose (default: 3000)
SESSION_SECRET=your-random-secret-key-here-change-this   # optional: auto-generated and persisted to data/session-secret if unset
COOKIE_SECURE=false         # set to true when serving over HTTPS (marks session cookie Secure)

# Data locations (optional; default to ./data and ./library)
# PRINTHIVE_DATA_DIR=/path/to/data
# PRINTHIVE_LIBRARY_DIR=/path/to/library

# Public URL (where your app is hosted)
PUBLIC_URL=https://your-domain.com

# OAuth Configuration
OAUTH_ISSUER=https://your-auth-server.com
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=https://your-domain.com/auth/callback

# Bambu Cloud API Configuration
BAMBU_CLOUD_API_URL=https://api.bambulab.com
